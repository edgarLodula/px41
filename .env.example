# ============================================================
# Variáveis de ambiente do projeto px41
# Copie para .env e preencha com seus valores reais.
# NUNCA commite o .env com valores reais.
# ============================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4o-mini

# --- HeyGen (geração de vídeos, opcional) ---
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# Ajustes finos de naturalidade do avatar (todos opcionais, com defaults sensatos):
# Engine: "avatar_iv" (padrão, suporta expressiveness) | "avatar_v" (qualidade maior, sem expressiveness)
HEYGEN_ENGINE=avatar_iv
# Velocidade da fala (0.5-1.5). Valores um pouco abaixo de 1.0 tendem a soar mais natural/pausado.
HEYGEN_SPEED=1.0
# Sotaque/idioma da voz.
HEYGEN_VOICE_LOCALE=pt-BR
# Expressividade padrão quando a cena não define uma direção própria: "low" | "medium" | "high"
HEYGEN_EXPRESSIVENESS=high
# Motion prompt genérico (fallback) quando a cena não tem [PRODUCAO] definido.
HEYGEN_MOTION_PROMPT=confident and warm, natural hand gestures while explaining, subtle head movement, direct eye contact with the camera

# --- Caminhos de dependências externas ---
# Deixe vazio para usar detecção automática pelo PATH
TESSERACT_PATH=
WKHTMLTOPDF_PATH=

# --- Logging ---
LOG_LEVEL=INFO

# --- Comportamento do pipeline ---
# Política de vocabulário proibido: warn | fail | retry
POLITICA_VOCABULARIO=warn

# Delays entre chamadas de API (segundos, use 0 em testes)
DELAY_ENTRE_TOPICOS=10
DELAY_ENTRE_SECOES=10
DELAY_ENTRE_DISCIPLINAS=35
